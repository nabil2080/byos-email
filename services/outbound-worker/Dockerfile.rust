FROM rustlang/rust:nightly-slim AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY packages/crypto-core/Cargo.toml packages/crypto-core/Cargo.toml
COPY packages/crypto-core/src packages/crypto-core/src
COPY services/outbound-worker/Cargo.toml services/outbound-worker/Cargo.toml
COPY services/outbound-worker/src services/outbound-worker/src
RUN cargo build --manifest-path services/outbound-worker/Cargo.toml --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/services/outbound-worker/target/release/byos-outbound-worker .
RUN chmod +x ./byos-outbound-worker
EXPOSE 8086
CMD ["./byos-outbound-worker"]
