---
import "../styles/global.css";
import { Footer } from "../components/layout/Footer";
import { HeaderUserNav } from "../components/layout/HeaderUserNav";
import { MobileMenu } from "../components/layout/MobileMenu";
import { StickyNav } from "../components/layout/StickyNav";
import { DesktopNav } from "../components/layout/DesktopNav";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = "Professional business email with custom domains, powerful mailbox tools, customer-controlled storage, and privacy-focused architecture.",
  ogType = "website",
} = Astro.props;

const siteName = "BYOS Business Email";
const fullTitle = title.includes("BYOS") ? title : `${title} | ${siteName}`;
const canonical = Astro.url?.pathname ?? "/";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#EAE6DE" />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.url).toString()} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.url).toString()} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Premium modern sans-serif */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="pt-4 bg-[#EAE6DE] text-[#18212A] antialiased flex flex-col min-h-screen selection:bg-[#226192] selection:text-[#EAE6DE] relative font-sans"
  >
    {/* Top scroll progress hairline */}
    <div
      id="scroll-progress"
      aria-hidden="true"
      class="fixed top-0 left-0 right-0 h-[2px] z-[60] origin-left bg-gradient-to-r from-[#226192] via-[#EF8557] to-[#226192] pointer-events-none"
      style="transform: scaleX(0)"
    ></div>

    {/* Primary Hanging Desktop Navigation (Top of page on Desktop) */}
    <DesktopNav client:load />

    {/* Floating Dynamic Sticky Navigation (Pill on Scroll) */}
    <StickyNav client:load />

    {/* Mobile Navigation Header (screens < lg) */}
    <header
      class="lg:hidden sticky top-0 z-40 border-b border-[#D8D3C9] bg-[#EAE6DE]/85 backdrop-blur-md supports-[backdrop-filter]:bg-[#EAE6DE]/75"
    >
      <div class="mx-auto max-w-7xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="BYOS home">
          <div
            class="flex items-center justify-center bg-[#226192] text-[#EAE6DE] px-2 py-0.5 rounded-lg text-xs font-mono font-bold tracking-wider shadow-xs group-hover:bg-[#1B4E76] transition-colors"
          >
            BYOS
          </div>
          <div class="flex flex-col leading-tight">
            <span class="font-bold text-sm tracking-tight text-[#18212A]">Business Email</span>
            <span class="text-[9px] font-mono uppercase tracking-[0.2em] text-[#55616D]">Your control</span>
          </div>
        </a>

        <div class="flex items-center gap-2">
          <HeaderUserNav client:load />
          <MobileMenu client:load />
        </div>
      </div>
    </header>

    {/* Main Page Content */}
    <main class="flex-1 relative">
      <slot />
    </main>

    {/* Footer */}
    <Footer client:load />

    {/* Scroll reveal + top scroll progress hairline */}
    <script is:inline>
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll("[data-reveal], [data-reveal-line]");
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
          );
          els.forEach((el) => io.observe(el));
        }

        const bar = document.getElementById("scroll-progress");
        if (bar && !reduce) {
          let ticking = false;
          const updateBar = () => {
            ticking = false;
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
            bar.style.transform = `scaleX(${p})`;
          };
          window.addEventListener("scroll", () => {
            if (!ticking) {
              ticking = true;
              window.requestAnimationFrame(updateBar);
            }
          }, { passive: true });
          updateBar();
        }
      })();
    </script>
  </body>
</html>
