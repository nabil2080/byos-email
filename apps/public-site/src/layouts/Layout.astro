---
import "../styles/global.css";
import { Footer } from "../components/layout/Footer";

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Business Email You Actually Own. Connect your own S3 or R2 storage with zero-knowledge encryption." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | BYOS Business Email</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#F0EEE9] text-[#3C3D3E] antialiased flex flex-col min-h-screen selection:bg-[#9E725F] selection:text-white">
    {/* Navigation */}
    <header class="sticky top-0 z-50 border-b border-[#E2DFD8] bg-[#F0EEE9]/90 backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="flex items-center justify-center bg-[#9E725F] text-white px-2.5 py-1 rounded-lg text-xs font-mono font-bold tracking-wider shadow-xs group-hover:bg-[#865E4D] transition-colors">
            BYOS
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-base tracking-tight text-[#3C3D3E]">Business Email</span>
            <span class="text-[9px] font-mono uppercase tracking-widest text-[#9E725F] font-semibold">Zero Server Plaintext</span>
          </div>
        </a>

        {/* Desktop Nav */}
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[#6F7173]">
          <a href="/#how-it-works" class="hover:text-[#3C3D3E] transition-colors">How It Works</a>
          <a href="/#pricing-calc" class="hover:text-[#3C3D3E] transition-colors">Cost Calculator</a>
          <a href="/#features" class="hover:text-[#3C3D3E] transition-colors">Features</a>
          <a href="/pricing" class="hover:text-[#3C3D3E] transition-colors">Pricing</a>
          <a href="/security" class="hover:text-[#3C3D3E] transition-colors">Security</a>
          <a href="/docs" class="hover:text-[#3C3D3E] transition-colors">Docs</a>
        </nav>

        {/* Action CTAs */}
        <div class="flex items-center gap-3">
          <a href="/login" class="text-xs sm:text-sm font-semibold text-[#3C3D3E] hover:text-[#9E725F] px-3 py-1.5 transition-colors">
            Sign In
          </a>
          <a href="/signup" class="rounded-xl bg-[#9E725F] px-4 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-[#865E4D] transition-all">
            Start Free Trial
          </a>
        </div>
      </div>
    </header>

    {/* Main Page Content */}
    <main class="flex-1 relative">
      <slot />
    </main>

    {/* Enterprise Footer */}
    <Footer client:load />
  </body>
</html>
