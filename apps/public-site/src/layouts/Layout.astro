---
import "../styles/global.css";
import { Footer } from "../components/layout/Footer";
import { HeaderUserNav } from "../components/layout/HeaderUserNav";
import { MobileMenu } from "../components/layout/MobileMenu";
import { StickyNav } from "../components/layout/StickyNav";
import { DesktopNav } from "../components/layout/DesktopNav";

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Business Email You Actually Own. Connect your own S3 or R2 storage with zero-knowledge encryption." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | BYOS Business Email</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="pt-4 bg-[#F0EEE9] text-[#3C3D3E] antialiased flex flex-col min-h-screen selection:bg-[#9E725F] selection:text-white relative">
    {/* Primary Hanging Desktop Navigation (Top of page on Desktop) */}
    <DesktopNav client:load />

    {/* Floating Dynamic Sticky Navigation (Pill with Popover Menus & Search on Scroll) */}
    <StickyNav client:load />

    {/* Mobile Navigation Header (Only visible on screens < lg down to 375px) */}
    <header class="lg:hidden sticky top-0 z-40 border-b border-[#E2DFD8] bg-[#F0EEE9] backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group shrink-0">
          <div class="flex items-center justify-center bg-[#9E725F] text-white px-2 py-0.5 rounded-lg text-xs font-mono font-bold tracking-wider shadow-xs group-hover:bg-[#865E4D] transition-colors">
            BYOS
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm tracking-tight text-[#2B2C2D]">Business Email</span>
            <span class="text-[9px] font-mono uppercase tracking-widest text-[#9E725F] font-semibold">Zero Markup</span>
          </div>
        </a>

        {/* User Auth Nav & Mobile Menu Drawer */}
        <div class="flex items-center gap-2">
          <HeaderUserNav client:load />
          <MobileMenu client:load />
        </div>
      </div>
    </header>

    {/* Main Page Content */}
    <main class="flex-1 relative">
      <slot />
    </main>

    {/* Enterprise Footer */}
    <Footer client:load />
  </body>
</html>
