---
import { FlutedGlassCanvas } from "../hero/FlutedGlassCanvas";

interface Props {
  title: string;
  badge?: string;
  description?: string;
}

const { title, badge, description } = Astro.props;
---

<header class="relative overflow-hidden rounded-[22px] md:rounded-[32px] mx-2 md:mx-4 bg-[#0B131B] text-[#EAE6DE] shadow-[0_24px_70px_-30px_rgba(20,14,11,0.6)]">
  {/* Soft WebGL Fluted Glass Shader */}
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute -right-24 -top-28 h-[420px] w-[420px] rounded-full blur-[130px] opacity-55"
      style="background: radial-gradient(circle, #226192 0%, transparent 72%)"
    ></div>
    <div
      class="absolute -left-20 -bottom-24 h-[360px] w-[360px] rounded-full blur-[120px] opacity-50"
      style="background: radial-gradient(circle, #EF8557 0%, transparent 72%)"
    ></div>
    <FlutedGlassCanvas client:load />
    <div class="absolute inset-0 backdrop-blur-[1px]"></div>
  </div>

  <div class="pointer-events-none absolute inset-0 z-[2] film-grain opacity-[0.04]" aria-hidden="true"></div>

  {/* Content Container */}
  <div class="relative z-10 max-w-5xl mx-auto px-6 pt-24 pb-16 sm:pt-32 sm:pb-20 text-center flex flex-col items-center justify-center">
    {badge && (
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/25 backdrop-blur-md border border-[#EAE6DE]/20 text-[#EF8557] text-[11px] font-mono uppercase tracking-[0.18em] mb-5">
        <span class="h-1.5 w-1.5 rounded-full bg-[#EF8557]"></span>
        <span>{badge}</span>
      </div>
    )}

    <h1 class="font-display text-3xl sm:text-5xl lg:text-[3.5rem] font-extrabold text-[#EAE6DE] tracking-tight leading-[1.05]">
      {title}
    </h1>

    {description && (
      <p class="mt-5 text-base sm:text-lg text-[#EAE6DE]/80 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>
    )}
  </div>
</header>
