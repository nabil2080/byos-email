---
interface Props {
  title: string;
  badge?: string;
  description?: string;
}

const { title, badge, description } = Astro.props;
---

<div class="relative overflow-hidden bg-[#2B2C2D] text-white border-b border-[#3C3D3E] shadow-lg">
  {/* Cryptographic dot grid texture */}
  <div class="absolute inset-0 opacity-15 crypto-dot-grid pointer-events-none"></div>

  {/* Ambient Mocha Mousse glow */}
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-[#9E725F]/20 rounded-full blur-3xl pointer-events-none"></div>

  {/* Content Container */}
  <div class="relative max-w-7xl mx-auto px-6 py-14 sm:py-20 text-center flex flex-col items-center justify-center min-h-[200px]">
    {badge && (
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#9E725F]/20 border border-[#9E725F]/40 text-[#F3ECE8] text-xs font-mono font-medium mb-4 shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-[#9E725F]"></span>
        <span>{badge}</span>
      </div>
    )}

    <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
      {title}
    </h1>

    {description && (
      <p class="mt-4 text-sm sm:text-base text-[#E2DFD8]/80 max-w-2xl mx-auto leading-relaxed">
        {description}
      </p>
    )}
  </div>

  {/* Subtle bottom bevel highlight */}
  <div class="absolute bottom-0 inset-x-0 h-[1px] bg-gradient-to-r from-transparent via-[#9E725F]/30 to-transparent"></div>
</div>
