---
import Layout from "../layouts/Layout.astro";

const plans = [
  {
    name: "Solo",
    monthly: 3,
    annual: 31,
    desc: "For independent founders, creators, and professionals requiring absolute email privacy.",
    mailboxes: 1,
    domains: 1,
    aliases: 10,
    badge: null,
    highlight: false,
  },
  {
    name: "Starter",
    monthly: 14,
    annual: 143,
    desc: "For small agile teams and early-stage startups needing multi-mailbox domains.",
    mailboxes: 5,
    domains: 2,
    aliases: 15,
    badge: null,
    highlight: false,
  },
  {
    name: "Business",
    monthly: 26,
    annual: 265,
    desc: "The ideal balance of mailbox capacity, multiple custom domains, and organizational control.",
    mailboxes: 10,
    domains: 3,
    aliases: 20,
    badge: "Most Popular",
    highlight: true,
  },
  {
    name: "Team",
    monthly: 60,
    annual: 612,
    desc: "Scalable capacity for growing companies with dedicated domain routing.",
    mailboxes: 25,
    domains: 5,
    aliases: 30,
    badge: null,
    highlight: false,
  },
  {
    name: "Business+",
    monthly: 110,
    annual: 1122,
    desc: "High-capacity tier for mid-size organizations requiring extensive custom domain routing.",
    mailboxes: 50,
    domains: 10,
    aliases: 40,
    badge: null,
    highlight: false,
  },
  {
    name: "Enterprise",
    monthly: "Custom",
    annual: "Custom",
    desc: "Custom SLAs, dedicated infrastructure, on-premise private cloud support, and audit terms.",
    mailboxes: "50+",
    domains: "Unlimited",
    aliases: "Unlimited",
    badge: "Enterprise SLA",
    highlight: false,
  },
];
---

<Layout title="Capacity-Based Pricing | Zero Storage Markup">
  {/* Header */}
  <section class="pt-20 pb-12 px-6 max-w-7xl mx-auto text-center ambient-glow">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EAE3DB] border border-[#A47764]/40 text-[#A47764] text-xs font-mono font-semibold mb-6 shadow-xs">
      <span>Section 25 &bull; Honest Capacity Pricing</span>
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-[#242424] tracking-tight">
      Pay for Scale, Not Feature Gates
    </h1>
    <p class="mt-4 text-base sm:text-lg text-[#4A4A4A] max-w-2xl mx-auto">
      Every plan includes the complete BYOS product &mdash; zero-knowledge cryptography, desktop IMAP bridge, and S3/MinIO connectors. You only pay for the capacity of mailboxes and domains you need.
    </p>

    {/* Toggle Switch */}
    <div class="mt-10 inline-flex items-center p-1.5 rounded-xl bg-[#EAE3DB] border border-[#D1C4B8] text-xs font-medium shadow-xs">
      <button id="monthly-btn" class="px-5 py-2 rounded-lg bg-[#A47764] text-[#F0EEE9] font-semibold transition-all shadow-xs">
        Monthly Billing
      </button>
      <button id="annual-btn" class="px-5 py-2 rounded-lg text-[#4A4A4A] hover:text-[#242424] transition-all flex items-center gap-2">
        <span>Annual Billing</span>
        <span class="bg-[#F0EEE9] text-[#A47764] border border-[#A47764]/40 px-1.5 py-0.5 rounded text-[10px] font-mono font-bold">Save 15%</span>
      </button>
    </div>
  </section>

  {/* Plan Cards Grid */}
  <section class="py-8 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {plans.map((p) => (
        <div class={`rounded-3xl border p-8 flex flex-col justify-between relative transition-all duration-300 shadow-xs ${
          p.highlight 
            ? "border-[#A47764] bg-[#E5DDD5] shadow-xl shadow-[#A47764]/15 ring-2 ring-[#A47764]" 
            : "border-[#D1C4B8] bg-[#FAF8F5] hover:border-[#A47764] hover:bg-[#F3EFEA]"
        }`}>
          {p.badge && (
            <div class="absolute -top-3 left-8 bg-[#A47764] text-[#F0EEE9] px-3 py-0.5 rounded-full text-[10px] font-mono uppercase font-bold tracking-wider shadow-sm">
              {p.badge}
            </div>
          )}

          <div>
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-bold text-[#242424]">{p.name}</h3>
              <span class="text-xs font-mono text-[#6E6E6E]">{p.mailboxes} Mailbox{typeof p.mailboxes === "number" && p.mailboxes === 1 ? "" : "es"}</span>
            </div>
            
            <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed min-h-[36px]">
              {p.desc}
            </p>

            {/* Price block */}
            <div class="mt-6 pb-6 border-b border-[#D1C4B8]">
              <div class="flex items-baseline gap-2">
                <span class="text-4xl font-extrabold text-[#242424] tracking-tight">
                  {typeof p.monthly === "number" ? `$${p.monthly}` : p.monthly}
                </span>
                {typeof p.monthly === "number" && (
                  <span class="text-sm font-medium text-[#4A4A4A]">/month</span>
                )}
              </div>
              {typeof p.annual === "number" && (
                <div class="text-[11px] font-mono text-[#A47764] font-semibold mt-1">
                  ${p.annual}/year billed annually
                </div>
              )}
            </div>

            {/* Resource specs */}
            <ul class="mt-6 space-y-3 text-xs text-[#4A4A4A]">
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-[#A47764] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-[#242424]">{p.mailboxes}</strong> dedicated mailbox{typeof p.mailboxes === "number" && p.mailboxes === 1 ? "" : "es"}</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-[#A47764] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-[#242424]">{p.domains}</strong> custom domain{typeof p.domains === "number" && p.domains === 1 ? "" : "s"}</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-[#A47764] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span><strong class="text-[#242424]">{p.aliases}</strong> email aliases per mailbox</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>Full BYOS S3, MinIO &amp; Google Drive support</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>Client-Side HPKE (RFC 9180) Cryptography</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span>Desktop IMAP / SMTP Bridge included</span>
              </li>
            </ul>
          </div>

          <a 
            href="http://127.0.0.1:3000/register" 
            class={`mt-8 block text-center rounded-xl py-3 px-4 text-xs font-semibold transition-all ${
              p.highlight
                ? "bg-[#A47764] hover:bg-[#8E6250] text-[#F0EEE9] shadow-md shadow-[#A47764]/25"
                : "bg-[#EAE3DB] hover:bg-[#E5DDD5] text-[#242424] border border-[#D1C4B8]"
            }`}
          >
            {p.name === "Enterprise" ? "Contact Enterprise Sales" : `Get Started with ${p.name}`}
          </a>
        </div>
      ))}
    </div>
  </section>

  {/* Visual ROI Calculator (Secondary Section) */}
  <section class="py-16 px-6 max-w-7xl mx-auto">
    <div class="rounded-3xl border border-[#D1C4B8] bg-[#E5DDD5] p-8 sm:p-12 shadow-lg">
      <div class="max-w-3xl">
        <span class="text-xs font-mono text-[#A47764] font-bold">TCO COMPARISON</span>
        <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold text-[#242424] tracking-tight">
          How Much Do You Save with BYOS?
        </h2>
        <p class="mt-3 text-sm text-[#4A4A4A] leading-relaxed">
          Traditional business email providers charge astronomical markups on storage &mdash; up to $7.20 to $18 per user per month. With BYOS, raw S3 storage costs just ~$0.023/GB.
        </p>
      </div>

      {/* Comparison Grid */}
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Google Workspace */}
        <div class="p-6 rounded-2xl bg-[#F0EEE9] border border-[#D1C4B8] shadow-xs">
          <div class="text-xs font-mono text-[#6E6E6E]">Google Workspace (Business Starter)</div>
          <div class="mt-3 text-3xl font-extrabold text-[#242424]">$144<span class="text-xs font-normal text-[#4A4A4A]">/mo</span></div>
          <div class="text-xs text-[#6E6E6E] mt-1">20 users &times; $7.20/user/mo</div>
          <div class="mt-4 pt-4 border-t border-[#D1C4B8] text-xs text-[#4A4A4A]">
            Total Annual: <strong class="text-[#242424]">$1,728 / year</strong>
          </div>
        </div>

        {/* Microsoft 365 */}
        <div class="p-6 rounded-2xl bg-[#F0EEE9] border border-[#D1C4B8] shadow-xs">
          <div class="text-xs font-mono text-[#6E6E6E]">Microsoft 365 (Business Basic)</div>
          <div class="mt-3 text-3xl font-extrabold text-[#242424]">$120<span class="text-xs font-normal text-[#4A4A4A]">/mo</span></div>
          <div class="text-xs text-[#6E6E6E] mt-1">20 users &times; $6.00/user/mo</div>
          <div class="mt-4 pt-4 border-t border-[#D1C4B8] text-xs text-[#4A4A4A]">
            Total Annual: <strong class="text-[#242424]">$1,440 / year</strong>
          </div>
        </div>

        {/* BYOS Team */}
        <div class="p-6 rounded-2xl bg-[#F0EEE9] border-2 border-[#A47764] ring-1 ring-[#A47764]/40 relative overflow-hidden shadow-md">
          <div class="text-xs font-mono text-[#A47764] font-bold">BYOS Business Email (Team Plan)</div>
          <div class="mt-3 text-3xl font-extrabold text-emerald-800">$62<span class="text-xs font-normal text-[#4A4A4A]">/mo</span></div>
          <div class="text-xs text-[#4A4A4A] mt-1">$60 BYOS Team + ~$2 S3 Storage (100GB)</div>
          <div class="mt-4 pt-4 border-t border-[#D1C4B8] text-xs text-emerald-800 font-bold">
            Total Annual: $744 / year &bull; <span class="underline">Save $984 / year</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ Section */}
  <section class="py-16 px-6 max-w-4xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-[#242424] text-center">Frequently Asked Questions</h2>
    
    <div class="mt-10 space-y-4">
      <div class="p-6 rounded-2xl bg-[#EAE3DB] border border-[#D1C4B8] shadow-xs">
        <h4 class="font-bold text-sm text-[#242424]">Do I have to pay Amazon or Google for storage separately?</h4>
        <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
          Yes. You provide your own AWS S3 bucket, Google Cloud Storage, or Google Drive. AWS charges ~$0.023/GB/month directly to your account. For typical corporate email usage, this translates to only a few pennies per employee per month.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#EAE3DB] border border-[#D1C4B8] shadow-xs">
        <h4 class="font-bold text-sm text-[#242424]">Can I self-host storage on my own servers?</h4>
        <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
          Absolutely. BYOS fully supports MinIO and any standard S3-compatible API. You can host MinIO in your private cloud or on-premise datacenter, and BYOS will stream encrypted payloads directly to it.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#EAE3DB] border border-[#D1C4B8] shadow-xs">
        <h4 class="font-bold text-sm text-[#242424]">Can BYOS read my emails?</h4>
        <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
          No. All email bodies and attachments are encrypted before storage using RFC 9180 HPKE. The private keys exist solely on your device and are derived from your 24-word BIP39 mnemonic. The BYOS server never stores customer master keys.
        </p>
      </div>
    </div>
  </section>
</Layout>
