---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import DynamicPricingCalculator from "../components/DynamicPricingCalculator";
---

<Layout title="Simple & Honest Pricing | Zero Storage Markup">
  <PageHeader
    title="Pay For Capacity. Not Storage Markups."
    badge="Honest Capacity-Based Pricing • 0% Storage Markup"
    description="No arbitrary plan tiers or artificial paywalls. Pay transparent rates for mailbox capacity with automatic volume discounts as your company grows."
  />

  {/* Dynamic Provisioning Calculator */}
  <section class="py-8 px-4 sm:px-6 max-w-4xl mx-auto">
    <DynamicPricingCalculator client:load initialSeats={10} />
  </section>

  {/* Visual ROI Calculator (Secondary Section) */}
  <section class="py-16 px-6 max-w-7xl mx-auto">
    <div class="rounded-3xl border border-[#E2DFD8] bg-white p-8 sm:p-12 shadow-xs">
      <div class="max-w-3xl">
        <span class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">Annual Cost Comparison</span>
        <h2 class="mt-2 text-2xl sm:text-4xl font-extrabold text-[#2B2C2D] tracking-tight">
          How Much You Save with BYOS
        </h2>
        <p class="mt-3 text-sm text-[#6F7173] leading-relaxed">
          Traditional email providers charge massive markups on storage — up to $7 to $18 per user per month. With BYOS, raw cloud storage in Cloudflare R2 or Amazon S3 costs just pennies per gigabyte.
        </p>
      </div>

      {/* Comparison Grid (20 Users Example) */}
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Google Workspace */}
        <div class="p-6 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] shadow-xs">
          <div class="text-xs font-semibold text-[#6F7173]">Google Workspace (Business Starter)</div>
          <div class="mt-3 text-3xl font-extrabold text-[#2B2C2D]">$144<span class="text-xs font-normal text-[#6F7173]">/mo</span></div>
          <div class="text-xs text-[#6F7173] mt-1">20 users &times; $7.20 / user / month</div>
          <div class="mt-4 pt-4 border-t border-[#E2DFD8] text-xs text-[#6F7173]">
            Total Annual: <strong class="text-[#2B2C2D]">$1,728 / year</strong>
          </div>
        </div>

        {/* Microsoft 365 */}
        <div class="p-6 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] shadow-xs">
          <div class="text-xs font-semibold text-[#6F7173]">Microsoft 365 (Business Basic)</div>
          <div class="mt-3 text-3xl font-extrabold text-[#2B2C2D]">$120<span class="text-xs font-normal text-[#6F7173]">/mo</span></div>
          <div class="text-xs text-[#6F7173] mt-1">20 users &times; $6.00 / user / month</div>
          <div class="mt-4 pt-4 border-t border-[#E2DFD8] text-xs text-[#6F7173]">
            Total Annual: <strong class="text-[#2B2C2D]">$1,440 / year</strong>
          </div>
        </div>

        {/* BYOS Sovereign Email */}
        <div class="p-6 rounded-2xl bg-[#F3ECE8]/50 border-2 border-[#9E725F] relative overflow-hidden shadow-xs">
          <div class="text-xs font-bold text-[#9E725F]">BYOS Business Email (20 Seats)</div>
          <div class="mt-3 text-3xl font-extrabold text-emerald-800">$41<span class="text-xs font-normal text-[#6F7173]">/mo</span></div>
          <div class="text-xs text-[#6F7173] mt-1">$39 BYOS Capacity + ~$2 Direct S3 / R2 Storage</div>
          <div class="mt-4 pt-4 border-t border-[#9E725F]/30 text-xs text-emerald-800 font-bold">
            Total Annual: $492 / year &bull; <span class="underline">Save up to $1,236 / year</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ Section */}
  <section class="py-16 px-6 max-w-4xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-[#2B2C2D] text-center">Frequently Asked Questions</h2>
    
    <div class="mt-10 space-y-4">
      <div class="p-6 rounded-2xl bg-white border border-[#E2DFD8] shadow-xs">
        <h4 class="font-bold text-sm text-[#2B2C2D]">How does storage billing work?</h4>
        <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
          You connect your own storage account (Cloudflare R2, Amazon AWS S3, or Google Drive). Your cloud provider bills you directly at standard raw commodity rates (~$0.015 - $0.023/GB). We take zero markup or commission on storage.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-[#E2DFD8] shadow-xs">
        <h4 class="font-bold text-sm text-[#2B2C2D]">Can I use self-hosted storage like MinIO?</h4>
        <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
          Yes. BYOS supports any S3-compatible storage system, including self-hosted MinIO servers in your private cloud or datacenter.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-[#E2DFD8] shadow-xs">
        <h4 class="font-bold text-sm text-[#2B2C2D]">Can BYOS read my emails?</h4>
        <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
          No. Your emails are locked and unlocked strictly on your laptop or phone. BYOS servers and cloud storage buckets only receive locked data that cannot be read without your device key.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-[#E2DFD8] shadow-xs">
        <h4 class="font-bold text-sm text-[#2B2C2D]">Can I keep using Apple Mail or Microsoft Outlook?</h4>
        <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
          Yes. You can use our fast webmail client, or connect Apple Mail, Outlook, or Thunderbird using standard email protocols.
        </p>
      </div>
    </div>
  </section>
</Layout>
