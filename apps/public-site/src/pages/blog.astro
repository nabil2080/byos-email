---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";

const upcoming = [
  {
    tag: "Storage",
    title: "Zero-Escrow Storage Interfaces",
    summary: "How BYOS separates mail delivery from S3, R2, and Google Drive persistence without locking your domain.",
  },
  {
    tag: "Cryptography",
    title: "Hybrid Post-Quantum Envelopes in Rust WASM",
    summary: "Combining ML-KEM-768 and X25519 inside Version 1 CryptoEnvelope for client-side decryption.",
  },
  {
    tag: "Deliverability",
    title: "Private Metadata vs. DKIM & Threading",
    summary: "What headers mail servers must read to route and thread conversations—and what stays sealed.",
  },
];
---

<Layout title="Engineering & Product Updates | BYOS Blog">
  <PageHeader
    title="Engineering & Product Dispatch"
    badge="BYOS Technical Journal"
    description="Deep dives on zero-knowledge cryptography, customer-controlled storage architectures, and sovereign email infrastructure."
  />

  <section class="py-16 pb-24 px-6 max-w-5xl mx-auto">
    <div class="card-editorial p-8 sm:p-12 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#226192]/30 bg-[#E2E7EB] px-3.5 py-1 text-xs font-mono font-bold text-[#1B4E76] uppercase tracking-wider mb-4">
        In Preparation
      </div>
      <h2 class="font-display text-2xl sm:text-4xl font-extrabold text-[#18212A] tracking-tight">
        Technical articles in progress
      </h2>
      <p class="mt-4 text-base text-[#55616D] max-w-xl mx-auto leading-relaxed">
        We're documenting the architecture behind BYOS Email—from client-side Rust WASM decryption to provider-neutral storage adapters.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-3 text-left">
        {upcoming.map((post) => (
          <div class="p-6 rounded-2xl bg-[#F6F3ED] border border-[#D8D3C9]">
            <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-[#226192]">{post.tag}</span>
            <h3 class="mt-2 font-display text-base font-bold text-[#18212A]">{post.title}</h3>
            <p class="mt-2 text-sm text-[#55616D] leading-relaxed">{post.summary}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary px-6 py-3 text-sm font-semibold">Return Home</a>
        <a href="/security" class="px-6 py-3 rounded-[10px] border border-[#D8D3C9] bg-[#F6F3ED] text-sm font-semibold text-[#18212A] hover:border-[#226192]/40 transition-colors">
          Read Security Specs
        </a>
      </div>
    </div>
  </section>
</Layout>
