---
import Layout from "../layouts/Layout.astro";
import { AnimatedHero } from "../components/hero/AnimatedHero";
import { StorageConstellation } from "../components/interactive/StorageConstellation";
import { PlatformShowcase } from "../components/interactive/PlatformShowcase";
import { InteropExplainer } from "../components/interactive/InteropExplainer";
import { SeatCalculator } from "../components/interactive/SeatCalculator";

const cpUrl = "http://127.0.0.1:3000";

const trustPoints = [
  "Customer-Controlled Storage",
  "Encrypted Mailbox Data",
  "Custom Business Domains",
  "Standard SMTP/IMAP Protocols",
  "Zero Lock-in & Independent Exit",
];

const securityDocs = [
  { label: "Security Architecture Spec", status: "Documented", link: "/security" },
  { label: "Threat Model & Trust Boundaries", status: "Under review", link: "/security" },
  { label: "Decoupled Storage Abstraction", status: "Implemented", link: "/docs" },
];

const migrationSteps = [
  { n: "01", title: "Connect Domain", body: "Point your business domain at BYOS using guided DNS records." },
  { n: "02", title: "Link Storage", body: "Connect the S3 bucket or Google Drive you already own." },
  { n: "03", title: "Provision Team", body: "Create mailboxes, aliases, and signatures for your organization." },
  { n: "04", title: "Start Sending", body: "Send and receive email through BYOS webmail or desktop clients." },
];
---

<Layout
  title="BYOS Business Email | Your Email. Your Storage. Your Control."
  description="Clean, modern business email with custom domains, customer-controlled persistent storage, and privacy-first architecture."
>
  {/* 1 — Hero */}
  <AnimatedHero client:load />

  {/* 2 — Trust Strip */}
  <section class="border-y border-[#E2DFD8] bg-[#F0EEE9] py-5">
    <div class="mx-auto max-w-7xl px-6">
      <div class="flex flex-wrap items-center justify-between gap-y-3 gap-x-6 text-[11px] font-mono uppercase tracking-[0.16em] text-[#6F7173]">
        {trustPoints.map((point) => (
          <div class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-[#9E725F]"></span>
            <span>{point}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 3 — Core Architecture & Storage Control */}
  <section id="how-it-works" class="scroll-mt-20 py-20 sm:py-28 bg-[#F0EEE9]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-2xl" data-reveal>
        <span class="eyebrow">Decoupled Architecture</span>
        <h2 class="mt-3 font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#2B2C2D] leading-[1.08]">
          Keep your mailbox where you control it.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-[#6F7173] leading-relaxed">
          Traditional email providers bundle service and persistent storage together. BYOS separates them:
          we manage mail transport and webmail, while your encrypted messages live in your own S3 bucket or Google Drive.
        </p>
      </div>

      <div class="mt-12" data-reveal style="--reveal-delay: 100ms">
        <StorageConstellation client:visible />
      </div>
    </div>
  </section>

  {/* 4 — Mailbox & Platform Experience */}
  <section id="features" class="scroll-mt-20 py-20 sm:py-28 bg-[#F3ECE8]/60 border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-7xl px-6">
      <div data-reveal>
        <PlatformShowcase client:visible />
      </div>
    </div>
  </section>

  {/* 5 — Interoperability & Security */}
  <section id="security-proof" class="scroll-mt-20 py-20 sm:py-28 bg-[#F0EEE9] border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        {/* Left: Interoperability Explainer */}
        <div class="lg:col-span-7" data-reveal>
          <InteropExplainer client:visible />
        </div>

        {/* Right: Security Documentation */}
        <div class="lg:col-span-5" data-reveal style="--reveal-delay: 120ms">
          <div class="card-editorial bg-white p-6 sm:p-7 border border-[#E2DFD8]">
            <span class="eyebrow">Inspectable Security</span>
            <h3 class="mt-2 font-display text-2xl font-bold text-[#2B2C2D]">
              Security built to be verified.
            </h3>
            <p class="mt-3 text-sm text-[#6F7173] leading-relaxed">
              We publish our security architecture, threat models, and recovery specifications so both owners and technical teams can inspect every detail.
            </p>

            <div class="mt-6 space-y-3">
              {securityDocs.map((doc) => (
                <a
                  href={doc.link}
                  class="group flex items-center justify-between p-3.5 rounded-xl border border-[#E2DFD8] bg-[#FBFAF7] hover:border-[#9E725F]/40 hover:bg-white transition-all"
                >
                  <span class="text-xs font-semibold text-[#2B2C2D] group-hover:text-[#9E725F] transition-colors">
                    {doc.label}
                  </span>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded-md border border-[#E2DFD8] bg-white text-[#6F7173]">
                    {doc.status}
                  </span>
                </a>
              ))}
            </div>

            <div class="mt-6 flex items-center gap-4 pt-4 border-t border-[#E2DFD8]">
              <a href="/security" class="text-xs font-bold text-[#9E725F] hover:underline">
                Explore Security Center &rarr;
              </a>
              <a href="/docs" class="text-xs font-semibold text-[#6F7173] hover:text-[#2B2C2D]">
                Documentation
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 6 — Capacity Pricing */}
  <section id="pricing-calc" class="scroll-mt-20 py-20 sm:py-28 bg-[#F3ECE8]/40 border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-2xl mb-10" data-reveal>
        <span class="eyebrow">Fair Pricing</span>
        <h2 class="mt-2 font-display text-3xl sm:text-4xl font-extrabold text-[#2B2C2D]">
          One complete product. Rate scales with team size.
        </h2>
        <p class="mt-3 text-base text-[#6F7173]">
          No feature-gating or artificial tiers. Every seat receives full product capabilities and custom storage integration.
        </p>
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <SeatCalculator client:visible />
      </div>
    </div>
  </section>

  {/* 7 — Streamlined Onboarding & Charcoal CTA */}
  <section class="border-t border-[#E2DFD8]">
    {/* Onboarding steps strip */}
    <div class="bg-[#F0EEE9] py-16 sm:py-20 border-b border-[#E2DFD8]">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-xl mb-10" data-reveal>
          <span class="eyebrow">Simple Setup</span>
          <h2 class="mt-2 font-display text-2xl sm:text-3xl font-extrabold text-[#2B2C2D]">
            Up and running in four straightforward steps.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" data-reveal style="--reveal-delay: 100ms">
          {migrationSteps.map((s) => (
            <div class="card-editorial bg-white p-5 border border-[#E2DFD8]">
              <span class="text-xs font-mono font-bold text-[#9E725F]">{s.n}</span>
              <h3 class="mt-2 font-display text-base font-bold text-[#2B2C2D]">{s.title}</h3>
              <p class="mt-1.5 text-xs text-[#6F7173] leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* Final Charcoal CTA */}
    <div class="relative overflow-hidden bg-[#3C3D3E] text-[#F0EEE9] py-20 sm:py-24">
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-80 w-[40rem] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[140px] opacity-25"
        style="background-color:#C89F8D"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-display text-3xl sm:text-5xl font-extrabold leading-[1.08]" data-reveal>
          Bring your business email under your control.
        </h2>
        <p class="mt-5 text-base sm:text-lg text-[#F0EEE9]/75 leading-relaxed" data-reveal style="--reveal-delay: 100ms">
          Professional email infrastructure. Customer-controlled storage. Clean, privacy-first webmail.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4" data-reveal style="--reveal-delay: 150ms">
          <a
            href={`${cpUrl}/register`}
            class="px-8 py-3.5 btn-primary text-base font-semibold shadow-md"
          >
            Get Started Now
          </a>
          <a
            href="/security"
            class="px-7 py-3.5 rounded-[10px] border border-white/20 bg-white/5 text-base font-semibold text-[#F0EEE9] transition-all hover:bg-white/10"
          >
            Read Security Whitepaper
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
