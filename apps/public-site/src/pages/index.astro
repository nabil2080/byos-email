---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy-First Business Email | Customer-Controlled Storage">
  {/* Hero Section */}
  <section class="relative pt-20 pb-16 px-6 max-w-7xl mx-auto text-center ambient-glow">
    {/* Badge */}
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EAE3DB] border border-[#A47764]/50 text-[#A47764] text-xs font-mono font-semibold mb-8 shadow-xs">
      <span class="h-1.5 w-1.5 rounded-full bg-[#A47764] animate-ping"></span>
      <span>Zero Server Plaintext &bull; Customer-Controlled Object Storage</span>
    </div>

    {/* Hero Headline */}
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-[#242424] tracking-tight leading-[1.1] max-w-4xl mx-auto">
      Normal Email on the Outside.<br />
      <span class="text-[#A47764]">Your Storage</span> Underneath.
    </h1>

    {/* Subtitle */}
    <p class="mt-6 text-base sm:text-xl text-[#4A4A4A] leading-relaxed max-w-2xl mx-auto font-normal">
      Full corporate email capability &mdash; custom domains, desktop IMAP/SMTP bridge, and scheduled sending &mdash; with persistent encrypted mailbox storage under your exclusive control in AWS S3, MinIO, or Google Drive.
    </p>

    {/* Action Buttons */}
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="http://127.0.0.1:3000/register" class="rounded-xl bg-[#A47764] px-6 py-3.5 text-sm sm:text-base font-semibold text-[#F0EEE9] shadow-lg shadow-[#A47764]/25 hover:bg-[#8E6250] transition-all">
        Launch Control Plane &rarr;
      </a>
      <a href="#architecture" class="rounded-xl border border-[#D1C4B8] bg-[#EAE3DB] px-6 py-3.5 text-sm sm:text-base font-medium text-[#242424] hover:border-[#A47764] hover:bg-[#E5DDD5] transition-all">
        Explore Architecture
      </a>
      <a href="/pricing" class="rounded-xl border border-[#D1C4B8] bg-transparent px-5 py-3.5 text-sm sm:text-base font-medium text-[#4A4A4A] hover:text-[#242424] hover:border-[#A47764] transition-all">
        View Pricing
      </a>
    </div>

    {/* Security Highlights Pill Row */}
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-xs font-mono text-[#4A4A4A]">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#A47764]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>RFC 9180 HPKE Core</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#A47764]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        <span>Direct S3 / MinIO Storage</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#A47764]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>Zero Server Plaintext at Rest</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#A47764]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span>Desktop IMAP / SMTP Bridge</span>
      </div>
    </div>
  </section>

  {/* Visual Element 1: High-Fidelity Webmail Client Mockup */}
  <section class="py-12 px-6 max-w-7xl mx-auto">
    <div class="rounded-2xl border border-[#D1C4B8] bg-[#FAF8F5] shadow-2xl overflow-hidden">
      {/* Browser Chrome Header */}
      <div class="px-4 py-3 bg-[#E5DDD5] border-b border-[#D1C4B8] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#C4B7AB]"></span>
          <span class="w-3 h-3 rounded-full bg-[#C4B7AB]"></span>
          <span class="w-3 h-3 rounded-full bg-[#C4B7AB]"></span>
          <span class="ml-2 text-xs font-mono text-[#4A4A4A] font-semibold">BYOS Secure Webmail</span>
        </div>
        <div class="flex items-center gap-2 bg-[#F0EEE9] px-4 py-1 rounded-md border border-[#D1C4B8] text-xs font-mono text-[#242424]">
          <svg class="w-3.5 h-3.5 text-[#A47764]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>https://mail.acme-corp.com/inbox</span>
        </div>
        <div class="flex items-center gap-2 text-xs font-mono text-[#242424] bg-[#EAE3DB] px-2.5 py-1 rounded border border-[#D1C4B8]">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          <span>S3 Connected</span>
        </div>
      </div>

      {/* Webmail 3-Pane Body */}
      <div class="grid grid-cols-1 md:grid-cols-12 min-h-[460px] text-sm">
        {/* Left Sidebar (3 cols) */}
        <div class="md:col-span-3 border-r border-[#D1C4B8] bg-[#F0EEE9] p-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 pb-4 border-b border-[#D1C4B8]">
              <div class="w-9 h-9 rounded-lg bg-[#A47764] text-[#F0EEE9] flex items-center justify-center font-bold">
                AC
              </div>
              <div class="overflow-hidden">
                <div class="font-bold text-[#242424] truncate text-xs">Acme Corporation</div>
                <div class="text-[11px] font-mono text-[#6E6E6E] truncate">alex@acme-corp.com</div>
              </div>
            </div>

            <button class="mt-4 w-full rounded-lg bg-[#A47764] hover:bg-[#8E6250] text-[#F0EEE9] py-2 px-3 text-xs font-semibold flex items-center justify-center gap-2 transition-colors shadow-xs">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>Compose Encrypted</span>
            </button>

            <nav class="mt-6 space-y-1 text-xs">
              <div class="flex items-center justify-between px-3 py-2 rounded-md bg-[#E5DDD5] text-[#242424] font-semibold border border-[#D1C4B8]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#A47764]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                  <span>Inbox</span>
                </div>
                <span class="bg-[#A47764] text-[#F0EEE9] px-1.5 py-0.5 rounded text-[10px] font-mono font-bold">14</span>
              </div>
              <div class="flex items-center justify-between px-3 py-2 rounded-md text-[#4A4A4A] hover:bg-[#EAE3DB]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#6E6E6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                  <span>Sent</span>
                </div>
                <span class="text-[#6E6E6E] font-mono text-[10px]">128</span>
              </div>
              <div class="flex items-center justify-between px-3 py-2 rounded-md text-[#4A4A4A] hover:bg-[#EAE3DB]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#6E6E6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  <span>Drafts</span>
                </div>
                <span class="text-[#6E6E6E] font-mono text-[10px]">3</span>
              </div>
              <div class="flex items-center justify-between px-3 py-2 rounded-md text-[#4A4A4A] hover:bg-[#EAE3DB]">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#6E6E6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                  <span>Encrypted Vault</span>
                </div>
              </div>
            </nav>
          </div>

          {/* Mailbox Sovereignty Card */}
          <div class="p-3 bg-[#EAE3DB] border border-[#D1C4B8] rounded-lg mt-6 text-[11px] font-mono text-[#4A4A4A] space-y-1.5">
            <div class="text-[#A47764] font-bold">Vault Security</div>
            <div>Key: BIP39 Mnemonic</div>
            <div>Crypto: WASM HPKE</div>
            <div class="text-emerald-700 font-medium">Target: AWS S3 us-east-1</div>
          </div>
        </div>

        {/* Middle Message List (4 cols) */}
        <div class="md:col-span-4 border-r border-[#D1C4B8] bg-[#FAF8F5] overflow-y-auto divide-y divide-[#D1C4B8]">
          {/* Message Item 1 (Active) */}
          <div class="p-3.5 bg-[#EAE3DB] border-l-3 border-[#A47764] cursor-pointer">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-bold text-[#242424]">Sarah Chen (Partner Fund)</span>
              <span class="font-mono text-[#A47764] text-[10px] font-semibold">10:42 AM</span>
            </div>
            <div class="font-semibold text-xs text-[#242424] truncate">Series A Term Sheet &amp; Key Verification</div>
            <p class="text-[11px] text-[#4A4A4A] truncate mt-1">We have reviewed the BYOS cryptographic boundary report...</p>
            <div class="mt-2 flex items-center gap-2">
              <span class="bg-[#F0EEE9] text-[#A47764] border border-[#D1C4B8] text-[9px] font-mono px-1.5 py-0.5 rounded font-semibold">🔒 HPKE Verified</span>
              <span class="text-[#6E6E6E] text-[10px] font-mono">&bull; 1.4 MB S3</span>
            </div>
          </div>

          {/* Message Item 2 */}
          <div class="p-3.5 hover:bg-[#F3EFEA] cursor-pointer transition-colors">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-medium text-[#4A4A4A]">Security Team &bull; Cloudflare</span>
              <span class="font-mono text-[#6E6E6E] text-[10px]">Yesterday</span>
            </div>
            <div class="font-medium text-xs text-[#242424] truncate">DKIM &amp; SPF Records Verified: acme-corp.com</div>
            <p class="text-[11px] text-[#6E6E6E] truncate mt-1">Automated DNS verification completed successfully for selector...</p>
          </div>

          {/* Message Item 3 */}
          <div class="p-3.5 hover:bg-[#F3EFEA] cursor-pointer transition-colors">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-medium text-[#4A4A4A]">MinIO Storage Monitor</span>
              <span class="font-mono text-[#6E6E6E] text-[10px]">Sep 10</span>
            </div>
            <div class="font-medium text-xs text-[#242424] truncate">Bucket Migration Complete: 4,821 Objects</div>
            <p class="text-[11px] text-[#6E6E6E] truncate mt-1">Encrypted migration from MinIO test bucket to S3 production bucket...</p>
          </div>
        </div>

        {/* Right Message Preview Pane (5 cols) */}
        <div class="md:col-span-5 bg-[#FFFFFF] p-5 flex flex-col justify-between">
          <div>
            {/* Header */}
            <div class="border-b border-[#D1C4B8] pb-4">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-bold text-base text-[#242424] leading-snug">Series A Term Sheet &amp; Key Verification</h3>
                <span class="bg-[#EAE3DB] border border-[#A47764]/40 text-[#A47764] text-[10px] font-mono px-2 py-0.5 rounded font-bold">
                  End-to-End
                </span>
              </div>
              <div class="mt-2 text-xs text-[#4A4A4A]">
                From: <span class="text-[#242424] font-semibold">sarah.chen@partner-fund.com</span> &bull; To: <span class="text-[#242424]">alex@acme-corp.com</span>
              </div>

              {/* Security Verification Bar */}
              <div class="mt-3 grid grid-cols-2 gap-2 text-[10px] font-mono">
                <div class="bg-[#FAF8F5] p-1.5 rounded border border-[#D1C4B8] flex items-center gap-1.5 text-emerald-700 font-medium">
                  <span>&check;</span>
                  <span>DKIM: RSA-2048 Valid</span>
                </div>
                <div class="bg-[#FAF8F5] p-1.5 rounded border border-[#D1C4B8] flex items-center gap-1.5 text-[#A47764] font-medium">
                  <span>🔒</span>
                  <span>RFC 9180 HPKE Open</span>
                </div>
              </div>
            </div>

            {/* Email Body Content */}
            <div class="mt-4 text-xs text-[#4A4A4A] leading-relaxed space-y-3">
              <p>Hi Alex,</p>
              <p>
                Our legal and security compliance team has audited the BYOS mailbox architecture. We were impressed that our emails are encrypted directly with your team&apos;s public key before ever hitting disk, and that the encrypted blobs live in your own dedicated AWS S3 bucket.
              </p>
              <p>
                Attached is the executed Series A Term Sheet. Please review and countersign via your encrypted webmail client.
              </p>
            </div>

            {/* Attachment Box */}
            <div class="mt-6 p-3 bg-[#FAF8F5] rounded-lg border border-[#D1C4B8] flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-[#EAE3DB] border border-[#D1C4B8] flex items-center justify-center text-[#A47764]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <div class="font-semibold text-xs text-[#242424]">Executed_Term_Sheet.pdf.enc</div>
                  <div class="text-[10px] font-mono text-[#6E6E6E]">1.4 MB &bull; AES-256-GCM</div>
                </div>
              </div>
              <button class="text-xs font-semibold text-[#A47764] hover:text-[#8E6250] px-2.5 py-1 rounded bg-[#EAE3DB] border border-[#D1C4B8] transition-colors">
                Decrypt &amp; Download
              </button>
            </div>
          </div>

          <div class="pt-4 border-t border-[#D1C4B8] text-[10px] font-mono text-[#6E6E6E] flex items-center justify-between">
            <span>Storage Object: s3://acme-vault-east1/msg_018f91.enc</span>
            <span class="text-emerald-700 font-medium">Decrypted in Browser WASM</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Visual Element 2: The BYOS Pipeline Architecture (Mocha Mousse Secondary Section) */}
  <section id="architecture" class="py-20 px-6 max-w-7xl mx-auto">
    <div class="p-8 sm:p-12 rounded-3xl bg-[#E5DDD5] border border-[#D1C4B8] shadow-lg">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F0EEE9] border border-[#A47764]/40 text-[#A47764] text-xs font-mono mb-3 font-semibold">
          <span>Section 0 &bull; Trust Boundary Specification</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#242424] tracking-tight">
          How BYOS Protects Your Mailbox
        </h2>
        <p class="mt-4 text-sm sm:text-base text-[#4A4A4A]">
          Every incoming and outgoing message passes through a strict trust boundary. The server never stores your email bodies in plaintext.
        </p>
      </div>

      {/* Architectural Flow Diagram */}
      <div class="mt-12 grid grid-cols-1 md:grid-cols-4 gap-6">
        {/* Step 1 */}
        <div class="p-5 rounded-2xl bg-[#F0EEE9] border border-[#D1C4B8] flex flex-col justify-between shadow-xs">
          <div>
            <div class="text-[10px] font-mono text-[#A47764] font-bold">PHASE 01 &bull; INGEST</div>
            <h4 class="mt-2 text-base font-bold text-[#242424]">Standard Inbound SMTP</h4>
            <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
              Standard email protocol handoff from Gmail, Outlook, or external MX servers over TLS port 25.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#D1C4B8] text-[11px] font-mono text-[#6E6E6E]">
            Postfix &bull; Rspamd Spam Filter
          </div>
        </div>

        {/* Step 2 */}
        <div class="p-5 rounded-2xl bg-[#F0EEE9] border-2 border-[#A47764] flex flex-col justify-between shadow-md shadow-[#A47764]/10">
          <div>
            <div class="text-[10px] font-mono text-[#A47764] font-bold">PHASE 02 &bull; ENCRYPT</div>
            <h4 class="mt-2 text-base font-bold text-[#242424]">Zero-Knowledge Encrypt</h4>
            <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
              Transient mail router invokes the isolated crypto-worker to wrap the content key via HPKE (RFC 9180).
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#D1C4B8] text-[11px] font-mono text-[#A47764] font-semibold">
            DHKEM(X25519) + AES-GCM
          </div>
        </div>

        {/* Step 3 */}
        <div class="p-5 rounded-2xl bg-[#F0EEE9] border border-emerald-600/40 flex flex-col justify-between shadow-xs">
          <div>
            <div class="text-[10px] font-mono text-emerald-700 font-bold">PHASE 03 &bull; PERSIST</div>
            <h4 class="mt-2 text-base font-bold text-[#242424]">Customer Storage</h4>
            <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
              Encrypted payload is written directly to your connected bucket. BYOS servers retain 0 customer bytes.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#D1C4B8] text-[11px] font-mono text-emerald-700 font-semibold">
            AWS S3 &bull; MinIO &bull; Google Drive
          </div>
        </div>

        {/* Step 4 */}
        <div class="p-5 rounded-2xl bg-[#F0EEE9] border border-[#D1C4B8] flex flex-col justify-between shadow-xs">
          <div>
            <div class="text-[10px] font-mono text-[#A47764] font-bold">PHASE 04 &bull; READ</div>
            <h4 class="mt-2 text-base font-bold text-[#242424]">Client Decryption</h4>
            <p class="mt-2 text-xs text-[#4A4A4A] leading-relaxed">
              Your Webmail client (WASM) or desktop IMAP Bridge unwraps the mailbox private key on your device.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#D1C4B8] text-[11px] font-mono text-[#6E6E6E]">
            Browser WASM &bull; byos-bridge
          </div>
        </div>
      </div>

      {/* Trust Boundary Banner */}
      <div class="mt-8 p-4 rounded-xl bg-[#F0EEE9] border border-[#A47764]/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
        <div class="flex items-center gap-3">
          <span class="text-[#A47764] text-lg font-bold">&bull;</span>
          <span class="text-[#242424] font-bold">CRITICAL ARCHITECTURE INVARIANT:</span>
          <span class="text-[#4A4A4A]">Server never holds unencrypted email bodies or customer master keys at rest.</span>
        </div>
        <a href="/security" class="text-[#A47764] hover:text-[#8E6250] font-bold whitespace-nowrap">
          Read Threat Model &rarr;
        </a>
      </div>
    </div>
  </section>

  {/* Visual Element 3: Supported Storage Connectors Showcase */}
  <section id="storage" class="py-16 px-6 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#242424] tracking-tight">
        Connect Your Preferred Storage
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#4A4A4A]">
        Plug in your existing cloud infrastructure or self-host your storage bucket on-premise.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {/* Amazon S3 */}
      <div class="p-6 rounded-2xl border border-[#D1C4B8] bg-[#EAE3DB] hover:border-[#A47764] transition-all group shadow-xs">
        <div class="w-12 h-12 rounded-xl bg-[#F0EEE9] border border-[#D1C4B8] flex items-center justify-center text-[#A47764] group-hover:scale-105 transition-transform shadow-xs">
