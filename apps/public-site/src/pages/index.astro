---
import Layout from "../layouts/Layout.astro";
import { AnimatedHero } from "../components/hero/AnimatedHero";
import { BigIdeaSeparation } from "../components/interactive/BigIdeaSeparation";

const cpUrl = import.meta.env.PUBLIC_CP_URL || "http://localhost:3000";

const stack = [
  { label: "Your domain", value: "company.com" },
  { label: "BYOS", value: "Delivery & mailboxes" },
  { label: "Your mailbox", value: "you@company.com" },
  { label: "Your storage", value: "S3 · Drive · R2" },
];

const securityDocs = [
  { label: "Security architecture", status: "Documented" },
  { label: "Privacy boundaries", status: "Documented" },
  { label: "Recovery model", status: "Designed" },
  { label: "Storage model", status: "Implemented" },
  { label: "Interoperability limits", status: "Documented" },
  { label: "Threat model", status: "Under review" },
];

const statusTone: Record<string, string> = {
  Implemented: "border-[#9E725F]/30 bg-[#F3ECE8] text-[#865E4D]",
  Documented: "border-[#E2DFD8] bg-white text-[#6F7173]",
  Designed: "border-[#E2DFD8] bg-white text-[#6F7173]",
  "Under review": "border-[#E2DFD8] bg-white text-[#8B8E91]",
};
---

<Layout
  title="BYOS Business Email | Your Email. Your Storage. Your Control."
  description="Professional business email with custom domains, powerful mailbox tools, customer-controlled storage, and privacy-focused architecture."
>
  {/* 1 — Hero */}
  <AnimatedHero client:load />

  {/* 2 — The idea */}
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-editorial-rules opacity-50 pointer-events-none" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-16 items-center">
      <div data-reveal>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.05] text-[#2B2C2D]">
          Your email shouldn't decide where your data lives.
        </h2>
        <p class="mt-6 max-w-lg text-lg text-[#6F7173] leading-relaxed">
          Most providers bundle the mailbox and the storage together, so leaving means losing
          access. BYOS keeps the two separate: we run the service, and your persistent mailbox
          data stays in storage you control.
        </p>
      </div>
      <div data-reveal style="--reveal-delay: 120ms">
        <BigIdeaSeparation client:visible />
      </div>
    </div>
  </section>

  {/* 3 — How it works: one compact strip, not four separate sections */}
  <section id="how-it-works" class="scroll-mt-24 py-20 sm:py-24 border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-xl" data-reveal>
        <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-[#2B2C2D] leading-[1.1]">
          Normal email on the outside. Your control underneath.
        </h2>
      </div>

      <div class="relative mt-14" data-reveal style="--reveal-delay: 100ms">
        <div class="hidden md:block absolute left-0 right-0 top-[13px] h-px bg-[#E2DFD8]" aria-hidden="true"></div>
        <div class="grid gap-8 md:grid-cols-4 md:gap-4">
          {stack.map((s) => (
            <div class="relative pt-8 md:pt-9">
              <span class="hidden md:block absolute left-0 top-1.5 h-3 w-3 rounded-full border-2 border-[#F0EEE9] bg-[#9E725F]" aria-hidden="true"></span>
              <h3 class="font-display text-lg font-bold text-[#2B2C2D]">{s.label}</h3>
              <p class="mt-1 text-sm font-mono text-[#6F7173]">{s.value}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="mt-10 max-w-2xl text-base text-[#6F7173] leading-relaxed" data-reveal style="--reveal-delay: 160ms">
        BYOS handles the email infrastructure. You control where your persistent mailbox data
        lives — that's the one decision that makes it different.
      </p>
    </div>
  </section>

  {/* 4 — What's included: consolidated bento, replaces six separate full-height sections */}
  <section id="features" class="scroll-mt-24 py-24 sm:py-32 border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-xl" data-reveal>
        <h2 class="font-display text-4xl sm:text-5xl font-extrabold text-[#2B2C2D] leading-[1.06]">
          Everything a business mailbox needs.
        </h2>
        <p class="mt-5 text-lg text-[#6F7173] leading-relaxed">
          A complete, believable mailbox — not a stripped-down privacy experiment.
        </p>
      </div>

      <div class="mt-14 grid gap-4 lg:grid-cols-6" data-reveal style="--reveal-delay: 100ms">
        {/* Storage — the emphasis cell, spans wider */}
        <div class="lg:col-span-4 card-editorial p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold text-[#2B2C2D]">Storage, your choice</h3>
          <p class="mt-2 max-w-md text-sm text-[#6F7173] leading-relaxed">
            Connect the storage you already trust. BYOS uses a provider-neutral interface, so
            your persistent mailbox data stays under your account, not locked inside ours.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {["Amazon S3", "Cloudflare R2", "Google Drive", "Backblaze B2", "Wasabi", "Azure Blob"].map((tag) => (
              <span class="rounded-md border border-[#E2DFD8] bg-[#FBFAF7] px-2.5 py-1 font-mono text-[11px] text-[#3C3D3E]">
                {tag}
              </span>
            ))}
          </div>
        </div>

        {/* Custom domains */}
        <div class="lg:col-span-2 card-editorial p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold text-[#2B2C2D]">Custom domains</h3>
          <p class="mt-2 text-sm text-[#6F7173] leading-relaxed">
            Bring your own domain. Aliases, mailbox identities, and signatures — no mail server
            required.
          </p>
        </div>

        {/* Full mailbox */}
        <div class="lg:col-span-3 card-editorial p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold text-[#2B2C2D]">A full mailbox</h3>
          <p class="mt-2 text-sm text-[#6F7173] leading-relaxed">
            The tools your team already relies on.
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {["Inbox", "Folders", "Rules", "Signatures", "Scheduled send", "Attachments"].map((c) => (
              <span class="rounded-full border border-[#E2DFD8] bg-white px-2.5 py-1 text-[11px] font-medium text-[#3C3D3E]">
                {c}
              </span>
            ))}
          </div>
        </div>

        {/* Compatibility */}
        <div class="lg:col-span-3 card-editorial p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold text-[#2B2C2D]">Works with your client</h3>
          <p class="mt-2 text-sm text-[#6F7173] leading-relaxed">
            Outlook, Apple Mail, Thunderbird, or the built-in webmail — standard protocols, no
            lock-in to one interface.
          </p>
        </div>

        {/* Admin modes */}
        <div class="lg:col-span-3 card-editorial p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold text-[#2B2C2D]">Two account modes</h3>
          <p class="mt-2 text-sm text-[#6F7173] leading-relaxed">
            <span class="font-semibold text-[#3C3D3E]">Organization-managed</span> for business
            continuity, or <span class="font-semibold text-[#3C3D3E]">Private</span> for stronger
            separation from admin access. Set per mailbox.
          </p>
        </div>

        {/* Recovery */}
        <div class="lg:col-span-3 card-editorial p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold text-[#2B2C2D]">Own your exit</h3>
          <p class="mt-2 text-sm text-[#6F7173] leading-relaxed">
            Your mail already lives in storage you control, with an independent recovery and
            export path — not permanently dependent on the service.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 5 — Security */}
  <section id="security-proof" class="py-24 sm:py-32 border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-xl" data-reveal>
        <h2 class="font-display text-4xl sm:text-5xl font-extrabold text-[#2B2C2D] leading-[1.06]">
          Security you can actually inspect.
        </h2>
        <p class="mt-6 text-lg text-[#6F7173] leading-relaxed">
          We publish the architecture and its boundaries so both business owners and technical
          buyers can evaluate BYOS honestly. Independent security review is required before
          production launch and is not yet complete.
        </p>
      </div>

      <div class="mt-12 divide-y divide-[#E2DFD8] border-y border-[#E2DFD8]" data-reveal style="--reveal-delay: 100ms">
        {securityDocs.map((doc) => (
          <a
            href="/security"
            class="group flex items-center justify-between py-4 transition-colors hover:bg-[#FBFAF7]"
          >
            <span class="text-sm font-semibold text-[#2B2C2D] group-hover:text-[#9E725F] transition-colors">
              {doc.label}
            </span>
            <span class={`shrink-0 rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide ${statusTone[doc.status]}`}>
              {doc.status}
            </span>
          </a>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href="/security" class="px-6 py-3 btn-primary text-sm font-semibold">Explore Security</a>
        <a href="/docs" class="px-6 py-3 rounded-[10px] border border-[#E2DFD8] bg-white text-sm font-semibold text-[#2B2C2D] transition-all hover:border-[#9E725F]/40">Read the docs</a>
      </div>
    </div>
  </section>

  {/* 6 — Pricing teaser */}
  <section class="py-24 sm:py-28 bg-[#F3ECE8] border-t border-[#E2DFD8]">
    <div class="mx-auto max-w-3xl px-6 text-center" data-reveal>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-[#2B2C2D] leading-[1.1]">
        One complete product. Better pricing as you grow.
      </h2>
      <p class="mt-5 text-lg text-[#6F7173] leading-relaxed">
        No tiers to decode and no feature walls. Every seat gets the full product, storage billed
        at cost, and your rate improves automatically as your team grows.
      </p>
      <div class="mt-8">
        <a href="/pricing" class="px-7 py-3.5 btn-primary text-base font-semibold">See pricing</a>
      </div>
    </div>
  </section>

  {/* 7 — Final CTA */}
  <section class="relative overflow-hidden bg-[#3C3D3E] text-[#F0EEE9]">
    <div class="absolute left-1/2 top-0 h-72 w-[36rem] -translate-x-1/2 rounded-full blur-[130px] opacity-30 pointer-events-none" style="background-color:#C89F8D" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-28 text-center">
      <h2 class="font-display text-4xl sm:text-6xl font-extrabold leading-[1.04]" data-reveal>
        Bring your business email under your control.
      </h2>
      <p class="mt-6 text-lg text-[#F0EEE9]/70 leading-relaxed" data-reveal style="--reveal-delay: 100ms">
        Professional email infrastructure. Customer-controlled storage. Privacy designed into the
        experience. Set up in four steps — domain, storage, mailboxes, done.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal style="--reveal-delay: 160ms">
        <a href={`${cpUrl}/signup`} class="px-8 py-3.5 btn-primary text-base font-semibold">Get Started</a>
        <a href="/security" class="px-7 py-3.5 rounded-[10px] border border-white/20 bg-white/5 text-base font-semibold text-[#F0EEE9] transition-all hover:bg-white/10">Explore Security</a>
      </div>
    </div>
  </section>
</Layout>