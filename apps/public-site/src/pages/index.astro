---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy-First Business Email">
  {/* Hero Section */}
  <section class="py-24 text-center px-6 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-950/80 border border-sky-800 text-sky-400 text-xs font-semibold mb-6">
      <span>🔒</span> Customer-Controlled Persistent Storage
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight">
      Normal Email on the Outside.<br />
      <span class="text-sky-500">Your Storage</span> Underneath.
    </h1>
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
      BYOS gives your company full business email capability—custom domains, desktop client support, and scheduled send—while keeping persistent encrypted mailbox storage under your control in S3, MinIO, or Google Drive.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="http://127.0.0.1:3000/register" class="rounded-xl bg-sky-600 px-6 py-3.5 text-base font-bold text-white shadow-lg hover:bg-sky-500 transition-all">
        Start Free Trial
      </a>
      <a href="/security" class="rounded-xl border border-slate-700 bg-slate-800/50 px-6 py-3.5 text-base font-medium text-slate-200 hover:bg-slate-800 transition-all">
        Read Security Model &rarr;
      </a>
    </div>
  </section>

  {/* Feature Grid */}
  <section class="py-16 bg-slate-950 border-t border-slate-800 px-6">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-2xl font-bold text-white text-center">Core Platform Architecture</h2>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8">
          <div class="text-3xl mb-4">📦</div>
          <h3 class="text-xl font-bold text-white">Bring Your Own Storage</h3>
          <p class="mt-2 text-sm text-slate-400">
            Store your encrypted email objects in your own AWS S3, Google Cloud Storage, MinIO, or Google Drive. We never hold your unencrypted data.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8">
          <div class="text-3xl mb-4">🔐</div>
          <h3 class="text-xl font-bold text-white">Zero-Knowledge Crypto</h3>
          <p class="mt-2 text-sm text-slate-400">
            Client-side Rust/WASM core derives keys locally using BIP39 mnemonics and HPKE (RFC 9180). Mailbox private keys never leave your device unwrapped.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-8">
          <div class="text-3xl mb-4">⚡</div>
          <h3 class="text-xl font-bold text-white">Normal Email Compatibility</h3>
          <p class="mt-2 text-sm text-slate-400">
            Send and receive mail seamlessly with Gmail, Outlook, Yahoo, and standard desktop client Bridge applications (IMAP/SMTP).
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
