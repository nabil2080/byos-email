---
// Redirect public site login directly to Control Panel login
const cpUrl = import.meta.env.PUBLIC_CP_URL || "http://localhost:3000";
const rawUrl = Astro.request?.url || "";
const search = rawUrl.includes("?") ? rawUrl.slice(rawUrl.indexOf("?")) : (Astro.url.search || "");
return Astro.redirect(`${cpUrl}/login${search}`, 302);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${cpUrl}/login`} />
    <title>Redirecting to Control Panel Login...</title>
    <script is:inline define:vars={{ cpUrl }}>
      const search = window.location.search || "";
      window.location.replace(`${cpUrl}/login${search}`);
    </script>
  </head>
  <body class="bg-[#EAE6DE] text-[#18212A] flex items-center justify-center min-h-screen">
    <p class="text-sm">Redirecting to Control Panel Login...</p>
  </body>
</html>
