---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
---

<Layout title="Security Architecture & Privacy Guarantees">
  <PageHeader
    title="Private By Design. Not By Policy."
    badge="Verified Security Architecture • Privacy by Default"
    description="Most email providers promise they won't look at your emails. We designed BYOS so we mathematically couldn't, even if we wanted to."
  />

  {/* Visual Key Derivation Tree (Secondary Section) */}
  <section id="architecture" class="py-8 px-6 max-w-7xl mx-auto">
    <div class="p-8 sm:p-12 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
      <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">Device Key Security</div>
      <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-[#2B2C2D]">How Your Privacy Is Guaranteed</h2>
      <p class="mt-2 text-xs sm:text-sm text-[#6F7173] max-w-2xl leading-relaxed">
        Your email keys are generated right on your phone or computer. The master key never touches our servers.
      </p>

      {/* Visual Flow Grid */}
      <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
        {/* Node 1 */}
        <div class="p-5 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] flex flex-col justify-between shadow-2xs">
          <div>
            <div class="text-[10px] font-mono text-[#9E725F] font-bold uppercase">1. Recovery Phrase</div>
            <div class="mt-1 font-bold text-sm text-[#2B2C2D]">12/24-Word Secret Seed</div>
            <p class="mt-2 text-[11px] text-[#6F7173] leading-relaxed">
              Kept offline in your password manager or printed safely. Only you hold it.
            </p>
          </div>
          <div class="mt-4 text-[10px] font-mono text-[#6F7173] pt-2 border-t border-[#E2DFD8]">
            Your Possession Only
          </div>
        </div>

        {/* Node 2 */}
        <div class="p-5 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] flex flex-col justify-between shadow-2xs">
          <div>
            <div class="text-[10px] font-mono text-[#9E725F] font-bold uppercase">2. In-Memory Key</div>
            <div class="mt-1 font-bold text-sm text-[#2B2C2D]">Device Key Derivation</div>
            <p class="mt-2 text-[11px] text-[#6F7173] leading-relaxed">
              Derived securely inside your browser or email app while you are logged in.
            </p>
          </div>
          <div class="mt-4 text-[10px] font-mono text-[#6F7173] pt-2 border-t border-[#E2DFD8]">
            Never Transmitted
          </div>
        </div>

        {/* Node 3 */}
        <div class="p-5 rounded-2xl bg-[#F3ECE8]/50 border-2 border-[#9E725F] flex flex-col justify-between shadow-2xs">
          <div>
            <div class="text-[10px] font-mono text-[#9E725F] font-bold uppercase">3. Message Lock</div>
            <div class="mt-1 font-bold text-sm text-[#2B2C2D]">Sealed Cloud Storage</div>
            <p class="mt-2 text-[11px] text-[#6F7173] leading-relaxed">
              Incoming emails are sealed before storage. Only your device key can open them.
            </p>
          </div>
          <div class="mt-4 text-[10px] font-mono text-emerald-700 pt-2 border-t border-[#9E725F]/30 font-medium">
            100% Sealed on Cloud
          </div>
        </div>

        {/* Node 4 */}
        <div class="p-5 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] flex flex-col justify-between shadow-2xs">
          <div>
            <div class="text-[10px] font-mono text-[#9E725F] font-bold uppercase">4. Zero Plaintext Auth</div>
            <div class="mt-1 font-bold text-sm text-[#2B2C2D]">Safe Sign-In Challenge</div>
            <p class="mt-2 text-[11px] text-[#6F7173] leading-relaxed">
              Authentication uses mathematical challenge-response so your password is never exposed.
            </p>
          </div>
          <div class="mt-4 text-[10px] font-mono text-[#6F7173] pt-2 border-t border-[#E2DFD8]">
            Protected Sign In
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Threat Scenarios Matrix */}
  <section id="threats" class="py-12 px-6 max-w-7xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-[#2B2C2D] mb-6">Real-World Security Scenarios</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* Scenario 1 */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
        <div class="flex items-center gap-3">
          <span class="p-2 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono font-bold">SCENARIO 01</span>
          <h3 class="font-bold text-base text-[#2B2C2D]">Server or Database Breach</h3>
        </div>
        <div class="mt-4 space-y-2 text-xs text-[#6F7173] leading-relaxed">
          <p><strong class="text-[#2B2C2D]">Attacker Goal:</strong> Steal and inspect customer communications from central servers.</p>
          <p class="text-emerald-800 font-medium"><strong>Our Guarantee:</strong> Zero email bodies or attachments live in the database. An intruder finds only unreadable locked blocks without keys to decode them.</p>
        </div>
      </div>

      {/* Scenario 2 */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
        <div class="flex items-center gap-3">
          <span class="p-2 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono font-bold">SCENARIO 02</span>
          <h3 class="font-bold text-base text-[#2B2C2D]">Cloud Bucket Compromise</h3>
        </div>
        <div class="mt-4 space-y-2 text-xs text-[#6F7173] leading-relaxed">
          <p><strong class="text-[#2B2C2D]">Attacker Goal:</strong> Access files inside your Cloudflare R2 or Amazon S3 bucket directly.</p>
          <p class="text-emerald-800 font-medium"><strong>Our Guarantee:</strong> Every file is individually encrypted with industry-standard AES-256. Without the key on your local device, all files are meaningless noise.</p>
        </div>
      </div>

      {/* Scenario 3 */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
        <div class="flex items-center gap-3">
          <span class="p-2 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono font-bold">SCENARIO 03</span>
          <h3 class="font-bold text-base text-[#2B2C2D]">Lost or Stolen Device</h3>
        </div>
        <div class="mt-4 space-y-2 text-xs text-[#6F7173] leading-relaxed">
          <p><strong class="text-[#2B2C2D]">Attacker Goal:</strong> Gain physical access to an employee&apos;s laptop or phone.</p>
          <p class="text-emerald-800 font-medium"><strong>Our Guarantee:</strong> Organization admins can revoke the active session instantly from the control panel. Cached tokens are invalidated immediately.</p>
        </div>
      </div>

      {/* Scenario 4 */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
        <div class="flex items-center gap-3">
          <span class="p-2 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono font-bold">SCENARIO 04</span>
          <h3 class="font-bold text-base text-[#2B2C2D]">Rogue Server Administrator</h3>
        </div>
        <div class="mt-4 space-y-2 text-xs text-[#6F7173] leading-relaxed">
          <p><strong class="text-[#2B2C2D]">Attacker Goal:</strong> An internal operator or rogue engineer trying to inspect customer mail.</p>
          <p class="text-emerald-800 font-medium"><strong>Our Guarantee:</strong> No master decryption keys exist in the BYOS infrastructure. BYOS employees cannot decrypt your historical or incoming messages.</p>
        </div>
      </div>
    </div>
  </section>

  {/* RFC Standards Table */}
  <section class="py-12 px-6 max-w-7xl mx-auto">
    <div class="p-8 sm:p-10 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
      <h3 class="text-xl font-bold text-[#2B2C2D]">Open &amp; Audited Industry Standards</h3>
      <p class="mt-2 text-xs sm:text-sm text-[#6F7173]">
        We build upon open, battle-tested Internet Engineering Task Force (IETF) standards:
      </p>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-5 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] shadow-2xs">
          <div class="font-mono text-[#9E725F] font-bold">RFC 9180</div>
          <div class="font-bold text-[#2B2C2D] mt-1">Hybrid Public Key Encryption</div>
          <div class="text-[#6F7173] text-[11px] mt-1">Standard modern envelope encryption with AES-256-GCM.</div>
        </div>

        <div class="p-5 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] shadow-2xs">
          <div class="font-mono text-[#9E725F] font-bold">RFC 8032</div>
          <div class="font-bold text-[#2B2C2D] mt-1">Edwards-Curve Signatures</div>
          <div class="text-[#6F7173] text-[11px] mt-1">High-performance cryptographic verification for sign-ins.</div>
        </div>

        <div class="p-5 rounded-2xl bg-[#FBFBFA] border border-[#E2DFD8] shadow-2xs">
          <div class="font-mono text-[#9E725F] font-bold">RFC 6376</div>
          <div class="font-bold text-[#2B2C2D] mt-1">DomainKeys Identified Mail (DKIM)</div>
          <div class="text-[#6F7173] text-[11px] mt-1">2048-bit digital signatures ensuring trusted inbox delivery.</div>
        </div>
      </div>
    </div>
  </section>
</Layout>
