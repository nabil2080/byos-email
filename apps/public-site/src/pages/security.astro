---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";

const keySteps = [
  {
    step: "01 · Recovery Phrase",
    title: "12/24-Word Secret Seed",
    body: "Kept offline in your password manager or printed safely. Only you hold it.",
    footer: "Your Possession Only",
    highlight: false,
  },
  {
    step: "02 · In-Memory Key",
    title: "Client-Side Key Derivation",
    body: "Derived locally via Argon2id inside your browser's Rust WebAssembly engine while signed in.",
    footer: "Never Transmitted",
    highlight: false,
  },
  {
    step: "03 · Message Lock",
    title: "Sealed Cloud Storage",
    body: "Incoming mail is sealed with hybrid post-quantum encryption before reaching your storage.",
    footer: "100% Sealed on Storage",
    highlight: true,
  },
  {
    step: "04 · Zero Plaintext Auth",
    title: "Challenge-Response Sign-In",
    body: "Authentication verifies cryptographic proof without exposing your passphrase.",
    footer: "Protected Sign-In",
    highlight: false,
  },
];

const scenarios = [
  {
    code: "SCENARIO 01",
    title: "Server or Database Breach",
    goal: "Steal and inspect customer communications from central servers.",
    guarantee: "Zero plaintext email bodies or attachments live in the database. An intruder finds only sealed blocks without keys to decode them.",
    note: "To group replies into conversations, our server sees threading headers (Message-ID, In-Reply-To). It does not see subjects, message bodies, or attachments.",
  },
  {
    code: "SCENARIO 02",
    title: "Cloud Bucket Compromise",
    goal: "Access files inside your Cloudflare R2 or Amazon S3 bucket directly.",
    guarantee: "Every message and attachment is individually encrypted with AES-256-GCM. Without the key on your device, bucket objects are unreadable ciphertext.",
    note: null,
  },
  {
    code: "SCENARIO 03",
    title: "Lost or Stolen Device",
    goal: "Gain physical access to an employee's laptop or phone.",
    guarantee: "Organization admins can revoke active sessions instantly from the control panel, invalidating cached access immediately.",
    note: null,
  },
  {
    code: "SCENARIO 04",
    title: "Rogue Server Administrator",
    goal: "An internal operator or rogue engineer trying to inspect customer mail.",
    guarantee: "No master decryption keys exist in BYOS infrastructure. BYOS operators cannot decrypt your historical or incoming messages.",
    note: null,
  },
];

const standards = [
  {
    code: "POST-QUANTUM HYBRID",
    title: "X-Wing (ML-KEM-768 + X25519)",
    desc: "Post-quantum hybrid key encapsulation combined via SHA3-256 to protect against harvest-now, decrypt-later threats.",
  },
  {
    code: "RFC 9180",
    title: "Hybrid Public Key Encryption",
    desc: "Standard modern envelope encryption with AES-256-GCM authenticated encryption and classical X25519 fallback.",
  },
  {
    code: "RFC 8032",
    title: "Edwards-Curve Signatures",
    desc: "High-performance Ed25519 cryptographic verification for envelope integrity and sign-in challenges.",
  },
  {
    code: "RFC 6376",
    title: "DomainKeys Identified Mail (DKIM)",
    desc: "2048-bit digital signatures ensuring authenticated, trusted inbox deliverability.",
  },
];
---

<Layout title="Security Architecture & Privacy Guarantees">
  <PageHeader
    title="Private By Design. Not By Policy."
    badge="Security Architecture • Privacy by Default"
    description="Most email providers promise they won't look at your emails. We designed BYOS so we mathematically couldn't, even if we wanted to."
  />

  {/* Visual Key Derivation Tree */}
  <section id="architecture" class="scroll-mt-24 py-12 px-6 max-w-7xl mx-auto">
    <div class="card-editorial p-8 sm:p-12">
      <span class="eyebrow">Device Key Security</span>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold text-[#18212A]">
        How your privacy is guaranteed
      </h2>
      <p class="mt-3 text-base text-[#55616D] max-w-2xl leading-relaxed">
        Your email keys are derived right on your phone or computer. Your master decryption key never touches our servers.
      </p>

      {/* Visual Flow Grid */}
      <div class="mt-10 grid grid-cols-1 md:grid-cols-4 gap-5">
        {keySteps.map((item) => (
          <div
            class={`p-6 rounded-2xl flex flex-col justify-between transition-transform duration-200 hover:-translate-y-0.5 ${
              item.highlight
                ? "bg-[#E2E7EB] border-2 border-[#226192] shadow-sm"
                : "bg-[#F6F3ED] border border-[#D8D3C9]"
            }`}
          >
            <div>
              <div class="text-[11px] font-mono text-[#226192] font-bold uppercase tracking-wider">
                {item.step}
              </div>
              <h3 class="mt-2 font-display text-base font-bold text-[#18212A]">{item.title}</h3>
              <p class="mt-2.5 text-sm text-[#55616D] leading-relaxed">{item.body}</p>
            </div>
            <div
              class={`mt-5 pt-3 border-t text-xs font-mono font-medium ${
                item.highlight
                  ? "border-[#226192]/30 text-[#1B4E76]"
                  : "border-[#D8D3C9] text-[#55616D]"
              }`}
            >
              {item.footer}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Threat Scenarios Matrix */}
  <section id="threats" class="scroll-mt-24 py-12 px-6 max-w-7xl mx-auto">
    <div class="max-w-2xl mb-8">
      <span class="eyebrow">Threat Model</span>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold text-[#18212A]">
        Real-world security scenarios
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {scenarios.map((s) => (
        <div class="card-editorial card-hover-elevate p-7 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded-lg bg-[#E2E7EB] border border-[#226192]/30 text-[#1B4E76] text-[11px] font-mono font-bold tracking-wider">
              {s.code}
            </span>
            <h3 class="font-display font-bold text-lg text-[#18212A]">{s.title}</h3>
          </div>
          <div class="mt-5 space-y-3 text-sm text-[#55616D] leading-relaxed">
            <p>
              <strong class="text-[#18212A]">Attacker goal:</strong> {s.goal}
            </p>
            <p class="text-[#18212A] bg-[#E2E7EB]/60 border-l-2 border-[#226192] pl-3.5 py-2 rounded-r-lg">
              <strong class="text-[#1B4E76]">BYOS boundary:</strong> {s.guarantee}
            </p>
            {s.note && (
              <p class="text-xs text-[#55616D]">{s.note}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* Cryptography & RFC Standards */}
  <section id="standards" class="scroll-mt-24 py-12 pb-24 px-6 max-w-7xl mx-auto">
    <div class="card-editorial p-8 sm:p-12">
      <span class="eyebrow">Cryptographic Standards</span>
      <h2 class="mt-3 font-display text-2xl sm:text-3xl font-extrabold text-[#18212A]">
        Open &amp; battle-tested primitives
      </h2>
      <p class="mt-2.5 text-base text-[#55616D] max-w-2xl">
        Built on peer-reviewed IETF standards and post-quantum hybrid cryptography — never proprietary black-box ciphers.
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {standards.map((std) => (
          <div class="p-6 rounded-2xl bg-[#F6F3ED] border border-[#D8D3C9] flex flex-col justify-between">
            <div>
              <div class="font-mono text-[11px] text-[#226192] font-bold tracking-wider">{std.code}</div>
              <div class="font-display font-bold text-base text-[#18212A] mt-2">{std.title}</div>
            </div>
            <p class="text-sm text-[#55616D] mt-3 leading-relaxed">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
