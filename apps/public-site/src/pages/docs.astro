---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
---

<Layout title="Documentation & Setup Guides">
  <PageHeader
    title="Setup & Documentation Hub"
    badge="Getting Started • Product Guides"
    description="Everything you need to connect your cloud storage, configure custom company domains, and connect your favorite email apps."
  />

  {/* Guides Grid */}
  <section class="py-8 px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {/* Guide 1: S3 & R2 Storage */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white flex flex-col justify-between hover:border-[#9E725F]/50 transition-colors shadow-xs">
        <div>
          <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">Storage Setup</div>
          <h3 class="mt-2 text-lg font-bold text-[#2B2C2D]">Cloudflare R2 &amp; Amazon S3</h3>
          <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
            Step-by-step guide to generating API keys for your own cloud bucket and connecting it to BYOS in under two minutes.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2DFD8] flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#6F7173]">3 min read</span>
          <a href="http://127.0.0.1:3000/dashboard/storage" class="text-xs font-bold text-[#9E725F] hover:text-[#865E4D]">Storage Settings &rarr;</a>
        </div>
      </div>

      {/* Guide 2: Google Drive */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white flex flex-col justify-between hover:border-[#9E725F]/50 transition-colors shadow-xs">
        <div>
          <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">Storage Setup</div>
          <h3 class="mt-2 text-lg font-bold text-[#2B2C2D]">Google Drive &amp; MinIO</h3>
          <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
            Connect an existing Google Workspace or self-hosted private MinIO storage instance with automated sync.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2DFD8] flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#6F7173]">3 min read</span>
          <a href="http://127.0.0.1:3000/dashboard/storage" class="text-xs font-bold text-[#9E725F] hover:text-[#865E4D]">Connect Drive &rarr;</a>
        </div>
      </div>

      {/* Guide 3: Custom Domains */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white flex flex-col justify-between hover:border-[#9E725F]/50 transition-colors shadow-xs">
        <div>
          <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">DNS &amp; Delivery</div>
          <h3 class="mt-2 text-lg font-bold text-[#2B2C2D]">Custom Domain &amp; Verification</h3>
          <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
            Configure MX, SPF, and DKIM DNS records at Cloudflare, Namecheap, or GoDaddy for 100% inbox deliverability.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2DFD8] flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#6F7173]">4 min read</span>
          <a href="http://127.0.0.1:3000/dashboard/domains" class="text-xs font-bold text-[#9E725F] hover:text-[#865E4D]">Add Domain &rarr;</a>
        </div>
      </div>

      {/* Guide 4: Mail Apps Integration */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white flex flex-col justify-between hover:border-[#9E725F]/50 transition-colors shadow-xs">
        <div>
          <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">App Sync</div>
          <h3 class="mt-2 text-lg font-bold text-[#2B2C2D]">Apple Mail, Outlook &amp; Mobile</h3>
          <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
            Quick setup guide for connecting your corporate mailbox to iPhone Mail, macOS Mail, Microsoft Outlook, or Thunderbird.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2DFD8] flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#6F7173]">App Guide</span>
          <a href="http://127.0.0.1:3000/dashboard/settings" class="text-xs font-bold text-[#9E725F] hover:text-[#865E4D]">Client Setup &rarr;</a>
        </div>
      </div>

      {/* Guide 5: Recovery Phrase */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white flex flex-col justify-between hover:border-[#9E725F]/50 transition-colors shadow-xs">
        <div>
          <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">Account Safety</div>
          <h3 class="mt-2 text-lg font-bold text-[#2B2C2D]">Your Recovery Phrase &amp; 2FA</h3>
          <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
            Best practices for securely storing your offline recovery phrase and setting up 2-step verification for account protection.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2DFD8] flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#6F7173]">Security</span>
          <a href="/security" class="text-xs font-bold text-[#9E725F] hover:text-[#865E4D]">View Guide &rarr;</a>
        </div>
      </div>

      {/* Guide 6: Team Management */}
      <div class="p-6 rounded-3xl border border-[#E2DFD8] bg-white flex flex-col justify-between hover:border-[#9E725F]/50 transition-colors shadow-xs">
        <div>
          <div class="text-xs font-mono text-[#9E725F] font-bold uppercase tracking-wider">Administration</div>
          <h3 class="mt-2 text-lg font-bold text-[#2B2C2D]">Managing Seats &amp; Aliases</h3>
          <p class="mt-2 text-xs text-[#6F7173] leading-relaxed">
            How to invite team members, adjust capacity, assign custom domains, and configure email aliases in one central dashboard.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2DFD8] flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#6F7173]">Team Ops</span>
          <a href="http://127.0.0.1:3000/dashboard/members" class="text-xs font-bold text-[#9E725F] hover:text-[#865E4D]">Team Settings &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  {/* Standard DNS Reference Box */}
  <section class="py-12 px-6 max-w-7xl mx-auto">
    <div class="p-8 sm:p-10 rounded-3xl border border-[#E2DFD8] bg-white shadow-xs">
      <h3 class="text-lg font-bold text-[#2B2C2D]">Standard DNS Configuration Reference</h3>
      <p class="mt-1 text-xs text-[#6F7173]">Add these records to your domain registrar or Cloudflare DNS zone:</p>

      <div class="mt-6 font-mono text-xs overflow-x-auto bg-[#FBFBFA] p-5 rounded-2xl border border-[#E2DFD8] space-y-2.5 text-[#2B2C2D]">
        <div><span class="text-[#9E725F] font-bold">MX</span>   @   mail.yourdomain.com   Priority: 10</div>
        <div><span class="text-[#9E725F] font-bold">TXT</span>  @   &quot;v=spf1 include:_spf.byos.email ~all&quot;</div>
        <div><span class="text-[#9E725F] font-bold">TXT</span>  byos._domainkey.yourdomain.com   &quot;v=DKIM1; k=rsa; p=MIIBIjANBgkqhkiG9w0BAQE...&quot;</div>
        <div><span class="text-[#9E725F] font-bold">TXT</span>  _dmarc.yourdomain.com   &quot;v=DMARC1; p=reject; sp=reject;&quot;</div>
      </div>
    </div>
  </section>
</Layout>
