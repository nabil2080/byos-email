# ── Environment & Security Hardening (Release C3) ──
# BYOS_ENV controls the environment mode: "development", "staging", "production".
# Fail-closed invariant: ANY value other than "development" (including unset, empty, or unknown)
# strictly disables development conveniences, enforces explicit database URLs, strict CORS allowlists,
# and disables mock authentication bypasses.
BYOS_ENV=development

# Database Connection URLs
# Required in production and staging. If unset in development, services fall back to local dev credentials.
# DATABASE_URL=postgres://byos:secret_password@db.example.internal:5432/byos?sslmode=verify-full
# SUPPORT_DB_URL=postgres://role_support_agent:secret_password@db.example.internal:5432/byos?sslmode=verify-full

# CORS & CSRF Origin Controls
# Comma-separated origins allowed for cross-origin credentialed requests.
# In development, falls back to standard localhost/127.0.0.1 dev server ports if unset.
# In production/staging, MUST be explicitly specified. Unlisted origins are rejected.
BYOS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Trusted Reverse Proxy CIDRs (Client IP Resolution)
# Comma-separated list of trusted upstream proxy IP addresses or CIDR blocks (e.g. "127.0.0.1/32, 10.0.0.0/8").
# If unset or empty, NO proxies are trusted; X-Forwarded-For headers are ignored and the direct socket peer IP is used.
# If connecting socket peer is NOT in this list, X-Forwarded-For is ignored (spoofing protection).
BYOS_TRUSTED_PROXIES=

# Development-Only Security Bypass Flags
# WARNING: These flags MUST NEVER be enabled in production or staging.
# Any attempt to set these flags outside BYOS_ENV=development will cause services to abort startup immediately.
BYOS_DEV_MODE=0
BYOS_LEGACY_AUTH_ENABLED=false

# ── Local Infrastructure (Development Defaults) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=byos
POSTGRES_USER=byos
POSTGRES_PASSWORD=byos_dev_password

# PostgreSQL Continuous WAL Archiving & Backup Encryption (Release C6.8)
# Path to 256-bit AES-GCM backup key file on host (relative to compose file or absolute).
# In production, ensure this file is owned by root with 0400 permissions and isolated from the backup volume.
BYOS_BACKUP_KEY_FILE=./secrets/backup.key

# Off-Site Remote Object Storage Replication (Release C6.9 — Disabled by default)
# Credentials must be supplied via secure IAM roles or secret files (never commit secrets here).
BYOS_BACKUP_REMOTE_ENABLED=false
BYOS_BACKUP_REMOTE_ENDPOINT=
BYOS_BACKUP_REMOTE_REGION=us-east-1
BYOS_BACKUP_REMOTE_BUCKET=
BYOS_BACKUP_REMOTE_PREFIX=byos-prod
BYOS_BACKUP_REMOTE_PATH_STYLE=false
BYOS_BACKUP_REMOTE_REQUIRED=false
BYOS_BACKUP_REMOTE_MAX_RETRIES=2
BYOS_BACKUP_REMOTE_TIMEOUT=15s
BYOS_BACKUP_REMOTE_OBJECT_LOCK_MODE=GOVERNANCE
BYOS_BACKUP_REMOTE_OBJECT_LOCK_DAYS=7
# BYOS_BACKUP_KMS_PROVIDER=aws
# BYOS_BACKUP_KMS_KEY_ID=
# BYOS_BACKUP_KMS_REGION=us-east-1
# BYOS_BACKUP_REMOTE_ACCESS_KEY_FILE=/run/secrets/backup_remote_access_key
# BYOS_BACKUP_REMOTE_SECRET_KEY_FILE=/run/secrets/backup_remote_secret_key

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=http://localhost:9001
MINIO_ROOT_USER=byosminio
MINIO_ROOT_PASSWORD=byosminio_dev_password
MINIO_BUCKET=byos-local-mailbox

LOCAL_SMTP_HOST=localhost
LOCAL_SMTP_PORT=1025

# ── Outbound Real OTP Delivery (Local Development & Production) ──
# Set OTP_DELIVERY_MODE=live to enable real delivery; otherwise defaults to mock
OTP_DELIVERY_MODE=mock
OTP_DEV_ALLOWED_EMAILS=
OTP_DEV_ALLOWED_PHONE_NUMBERS=
OTP_HMAC_SECRET=

# Outbound Email Delivery (Authenticated SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=security@byos.local
SMTP_FROM_NAME="BYOS Security"
SMTP_ENCRYPTION=starttls

# Outbound SMS Delivery (Providers: twilio, greenweb, generic_http, mock)
OTP_SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Alternative: Greenweb Bangladesh (Local direct aggregator)
# OTP_SMS_PROVIDER=greenweb
# GREENWEB_TOKEN=
